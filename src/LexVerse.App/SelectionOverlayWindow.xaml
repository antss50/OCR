<Window x:Class="LexVerse.App.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#42000000"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Canvas x:Name="SelectionCanvas">
        <Border x:Name="SelectionBorder"
                Visibility="Collapsed"
                BorderBrush="#FFF2B84B"
                BorderThickness="2"
                Background="#24F2B84B"
                CornerRadius="5"/>
        <Border x:Name="SelectionSizeBadge"
                Visibility="Collapsed"
                Background="#E815181E"
                CornerRadius="6"
                Padding="8,4">
            <TextBlock x:Name="SelectionSizeText"
                       Foreground="#FFF2B84B"
                       FontSize="12"
                       FontWeight="SemiBold"/>
        </Border>
        <Border x:Name="Hint"
                Canvas.Left="28"
                Canvas.Top="28"
                Background="#F015181E"
                BorderBrush="#343A46"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12">
            <StackPanel>
                <TextBlock Text="Select a realtime translation region"
                           Foreground="#FFF5F7FA"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Drag around text · Esc to cancel"
                           Foreground="#FF9DA7B5"
                           FontSize="12"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
