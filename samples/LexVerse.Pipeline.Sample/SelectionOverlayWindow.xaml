<Window x:Class="LexVerse.Pipeline.Sample.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#33000000"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Canvas x:Name="SelectionCanvas">
        <Border x:Name="SelectionBorder"
                Visibility="Collapsed"
                BorderBrush="#FFD8A24A"
                BorderThickness="2"
                Background="#22D8A24A"
                CornerRadius="4"/>
        <TextBlock x:Name="SelectionSizeText"
                   Visibility="Collapsed"
                   Foreground="#FFD8A24A"
                   FontSize="12"
                   FontWeight="SemiBold"/>
        <Border x:Name="Hint"
                Canvas.Left="28"
                Canvas.Top="28"
                Background="#EE1C1814"
                BorderBrush="#FF3A3128"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Drag to select text area"
                           Foreground="#FFFFF7E9"
                           FontWeight="SemiBold"/>
                <Border Background="#342E27"
                        CornerRadius="5"
                        Padding="6,2"
                        Margin="12,0,0,0">
                    <TextBlock Text="Esc"
                               Foreground="#FFA79A89"
                               FontSize="11"/>
                </Border>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
