<Window x:Class="LexVerse.Pipeline.Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lexverse Control Center"
        Width="1460"
        Height="920"
        MinWidth="1120"
        MinHeight="760"
        Background="#080706"
        Foreground="#F6EFE2"
        FontFamily="Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStyle="None"
        ResizeMode="CanResize">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#080706"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#14110E"/>
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1D1915"/>
        <SolidColorBrush x:Key="InputBrush" Color="#28231D"/>
        <SolidColorBrush x:Key="InputRaisedBrush" Color="#302A24"/>
        <SolidColorBrush x:Key="InputTextBrush" Color="#FFF7E9"/>
        <SolidColorBrush x:Key="StrokeBrush" Color="#3A3128"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A79A89"/>
        <SolidColorBrush x:Key="DimTextBrush" Color="#716A60"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#D8A24A"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#8CC57B"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#D9A64B"/>
        <SolidColorBrush x:Key="WhiteTextBrush" Color="#FFF7E9"/>

        <Style x:Key="SectionLabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="StatusBadgeBorder" TargetType="Border">
            <Setter Property="Background" Value="#3A3128"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="StatusBadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="LineHeight" Value="16"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>

        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="#120F0A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E2AF5B"/>
                                <Setter Property="BorderBrush" Value="#E2AF5B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#2A261F"/>
            <Setter Property="BorderBrush" Value="#2A261F"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteTextBrush}"/>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#201C18"/>
            <Setter Property="BorderBrush" Value="#201C18"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        </Style>

        <Style x:Key="ShortcutButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="136"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>

        <Style x:Key="WindowChromeButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A261F"/>
                                <Setter Property="Foreground" Value="{StaticResource WhiteTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LightComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InputTextBrush}"/>
            <Setter Property="BorderBrush" Value="#453A31"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ComboToggle"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                MinHeight="38">
                                            <Grid>
                                                <TextBlock Margin="12,0,34,0"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource WhiteTextBrush}"
                                                           FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <TextBlock Text="&#xE70D;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="10"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource InputRaisedBrush}"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#5B4A3E"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource InputRaisedBrush}"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{StaticResource InputBrush}"
                                            BorderBrush="#5B4A3E"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="0,4,0,0">
                                        <ScrollViewer Margin="2"
                                                      CanContentScroll="True">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource InputTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{StaticResource WhiteTextBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3A3128"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#4A351A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#3A3128"/>
                    <Setter Property="Foreground" Value="{StaticResource WhiteTextBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4A351A"/>
                    <Setter Property="Foreground" Value="{StaticResource WhiteTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LightTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource InputTextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#453A31"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource WhiteTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder"
                                    Width="17"
                                    Height="17"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="#17130F"
                                    BorderBrush="#5E5247"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <TextBlock x:Name="CheckMark"
                                           Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#17130F"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#E2AF5B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24">
                            <Track x:Name="PART_Track"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="7"
                                                        Background="{StaticResource PrimaryBrush}"
                                                        CornerRadius="4"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16"
                                           Height="16"
                                           Background="#17130F"
                                           BorderBrush="{StaticResource PrimaryBrush}"
                                           BorderThickness="2">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="7"
                                                        Background="#27221D"
                                                        CornerRadius="4"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#100E0C"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="BorderBrush" Value="#27221D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14"
          MouseLeftButtonDown="WindowShell_MouseLeftButtonDown">
        <Border x:Name="WindowShell"
                Margin="0,0,0,0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="16"
                MouseLeftButtonDown="WindowShell_MouseLeftButtonDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="74"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="36"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#1B1713"
                        BorderBrush="#2F2923"
                        BorderThickness="0,0,0,1"
                        CornerRadius="16,16,0,0">
                    <Grid Margin="24,0"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Width="40"
                                    Height="40"
                                    Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="10">
                                <TextBlock Text="Lx"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#130F0A"
                                           FontWeight="Bold"/>
                            </Border>
                            <StackPanel Margin="16,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Lexverse"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="{StaticResource WhiteTextBrush}"/>
                                <TextBlock Text="CONTROL CENTER"
                                           Foreground="{StaticResource MutedTextBrush}"
                                            FontSize="12"
                                            x:Name="AppSubtitleText"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="PopupHotkeyButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="ActivatePopup_Click"
                                    Margin="0,0,10,0"
                                    ToolTip="Highlight text in any app, then press F6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconGlyph}"
                                               Text="&#xE7F4;"/>
                                    <TextBlock x:Name="HeaderPopupText"
                                               Text="Popup"/>
                                    <Border Background="#AE7E37"
                                            CornerRadius="6"
                                            Padding="6,2"
                                            Margin="10,0,0,0">
                                        <TextBlock x:Name="PopupHotkeyBadgeText"
                                                   Text="F6"
                                                   FontSize="12"
                                                   Foreground="#20160B"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button x:Name="RegionButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,10,0"
                                    Click="StartRegionRealtime_Click"
                                    Content="Region"/>
                            <Button x:Name="FullScreenButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,10,0"
                                    Click="StartFullScreenRealtime_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconGlyph}"
                                               Text="&#xE740;"/>
                                    <TextBlock x:Name="HeaderFullScreenText"
                                               Text="Full screen"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopButton"
                                    Style="{StaticResource QuietButton}"
                                    Width="88"
                                    IsEnabled="False"
                                    Click="StopButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconGlyph}"
                                               Text="&#xE71A;"/>
                                    <TextBlock x:Name="HeaderStopText"
                                               Text="Stop"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="SettingsButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Width="48"
                                    Padding="0"
                                    Click="OpenSettings_Click"
                                    ToolTip="Settings">
                                <TextBlock Text="&#xE713;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="#3A3128"
                                Margin="18,18,14,18"/>

                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource WindowChromeButton}"
                                    Click="MinimizeWindow_Click">
                                <TextBlock Text="&#xE921;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"/>
                            </Button>
                            <Button Style="{StaticResource WindowChromeButton}"
                                    Click="MaximizeWindow_Click">
                                <TextBlock Text="&#xE922;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"/>
                            </Button>
                            <Button Style="{StaticResource WindowChromeButton}"
                                    Click="CloseWindow_Click">
                                <TextBlock Text="&#xE711;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="#312A24"
                            BorderThickness="0,0,1,0"
                            Padding="20,22">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="LanguageSectionText"
                                           Style="{StaticResource SectionLabelText}"
                                           Text="LANGUAGE"/>
                                <TextBlock x:Name="FromLabelText"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,28,0,8"
                                           Text="FROM"/>
                                <ComboBox x:Name="OcrLanguageBox"
                                          Style="{StaticResource LightComboBox}"
                                          SelectedIndex="0">
                                    <ComboBoxItem Content="English" Tag="en-US"/>
                                    <ComboBoxItem Content="Japanese" Tag="ja-JP"/>
                                    <ComboBoxItem Content="Korean" Tag="ko-KR"/>
                                    <ComboBoxItem Content="Chinese" Tag="zh-CN"/>
                                </ComboBox>

                                <TextBlock x:Name="ToLabelText"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,24,0,8"
                                           Text="TO"/>
                                <ComboBox x:Name="TargetLanguageBox"
                                          Style="{StaticResource LightComboBox}"
                                          SelectedIndex="0">
                                    <ComboBoxItem Content="Vietnamese" Tag="vi"/>
                                    <ComboBoxItem Content="English" Tag="en"/>
                                    <ComboBoxItem Content="Japanese" Tag="ja"/>
                                    <ComboBoxItem Content="Korean" Tag="ko"/>
                                </ComboBox>

                                <TextBlock x:Name="IgnoredTermsLabelText"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,24,0,8"
                                           Text="IGNORED TERMS"/>
                                <TextBox x:Name="IgnoredTermsBox"
                                         Style="{StaticResource LightTextBox}"
                                         Height="78"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         TextChanged="TranslationSettings_TextChanged"
                                         Text="HP, MP, EXP..."/>

                                <TextBlock x:Name="OcrModeLabelText"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,24,0,8"
                                           Text="OCR MODE"/>
                                <ComboBox x:Name="ModeBox"
                                          Style="{StaticResource LightComboBox}"
                                          SelectedIndex="3">
                                    <ComboBoxItem Content="Fullscreen" Tag="fullscreen"/>
                                    <ComboBoxItem Content="Subtitle" Tag="subtitle"/>
                                    <ComboBoxItem Content="Game dialogue" Tag="game-dialogue"/>
                                    <ComboBoxItem Content="Document" Tag="document"/>
                                    <ComboBoxItem Content="Comic / manga" Tag="comic"/>
                                </ComboBox>

                                <Border Height="1"
                                        Background="#302A24"
                                        Margin="-20,28,-20,22"/>

                                <TextBlock x:Name="BehaviorSectionText"
                                           Style="{StaticResource SectionLabelText}"
                                           Text="BEHAVIOR"/>
                                <CheckBox x:Name="KeepTermsCheck"
                                          Margin="0,18,0,11"
                                          IsChecked="True"
                                          Checked="TranslationSettings_CheckedChanged"
                                          Unchecked="TranslationSettings_CheckedChanged"
                                          Content="Keep acronyms / technical terms"/>
                                <CheckBox x:Name="ClosePopupOnOutsideClickBox"
                                          IsChecked="True"
                                          Content="Close popup on outside click"/>
                                <CheckBox x:Name="AllowDraggingPopupBox"
                                          IsChecked="True"
                                          Content="Allow dragging popup"/>
                                <CheckBox x:Name="DebugOverlayBox"
                                          Visibility="Collapsed"
                                          Content="Show OCR debug boxes"/>
                                <CheckBox x:Name="ShowPopupBeforeTranslationFinishesBox"
                                          Content="Show popup before translation finishes"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <ScrollViewer Grid.Column="1"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Margin="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource CardBorder}"
                                    Margin="0,0,8,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30"
                                                Height="30"
                                                CornerRadius="7"
                                                Background="#342819"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="&#xE722;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       FontSize="14"
                                                       FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock x:Name="PopupModeTitleText"
                                                   Text="Popup Mode"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource WhiteTextBrush}"
                                                   FontSize="17"
                                                   FontWeight="Bold"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Style="{StaticResource StatusBadgeBorder}">
                                        <TextBlock Text="Bedrock"
                                                   Style="{StaticResource StatusBadgeText}"/>
                                    </Border>

                                    <StackPanel Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Orientation="Horizontal"
                                                Margin="0,18,0,0">
                                        <Button x:Name="PopupCaptureButton"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="ActivatePopup_Click"
                                                Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource IconGlyph}"
                                                           Text="&#xE722;"/>
                                                <TextBlock x:Name="PopupCaptureText"
                                                           Text="Capture"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Click="ShowPopupDemo_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource IconGlyph}"
                                                           Text="&#xE890;"/>
                                                <TextBlock x:Name="PopupPreviewText"
                                                           Text="Preview"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <TextBlock x:Name="SelectedSourceText"
                                               Grid.Row="2"
                                               Grid.ColumnSpan="2"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,18,0,0"
                                               Text="Highlight text in another app, then press F6."/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1"
                                    Style="{StaticResource CardBorder}"
                                    Margin="8,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30"
                                                Height="30"
                                                CornerRadius="7"
                                                Background="#1E2B1C"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="&#xE768;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       FontSize="14"
                                                       FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock x:Name="RealtimeModeTitleText"
                                                   Text="Realtime Mode"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource WhiteTextBrush}"
                                                   FontSize="17"
                                                   FontWeight="Bold"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Style="{StaticResource StatusBadgeBorder}">
                                        <TextBlock Text="Win OCR + Google"
                                                   Style="{StaticResource StatusBadgeText}"/>
                                    </Border>

                                    <StackPanel Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Orientation="Horizontal"
                                                Margin="0,18,0,0">
                                        <Button x:Name="RealtimeRegionButton"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="StartRegionRealtime_Click"
                                                 Content="Region"
                                                 Margin="0,0,10,0"/>
                                        <Button x:Name="RealtimeFullScreenButton"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="StartFullScreenRealtime_Click"
                                                Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource IconGlyph}"
                                                           Text="&#xE740;"/>
                                                <TextBlock x:Name="RealtimeFullScreenText"
                                                           Text="Full screen"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="RealtimeStopButton"
                                                Style="{StaticResource QuietButton}"
                                                Width="88"
                                                IsEnabled="False"
                                                Click="StopButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource IconGlyph}"
                                                           Text="&#xE71A;"/>
                                                <TextBlock x:Name="RealtimeStopText"
                                                           Text="Stop"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Grid.ColumnSpan="2"
                                                Orientation="Horizontal"
                                                Margin="0,18,0,0">
                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Fill="{StaticResource SuccessBrush}"
                                                 Margin="0,0,8,0"/>
                                        <TextBlock x:Name="RealtimeStateText"
                                                   Style="{StaticResource MutedText}"
                                                   Text="Idle"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    Style="{StaticResource CardBorder}"
                                    Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock x:Name="RealtimeTuningTitleText"
                                               Style="{StaticResource SectionLabelText}"
                                               Text="REALTIME TUNING"/>

                                    <Grid Margin="0,26,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:Name="ScanIntervalLabelText"
                                                   Text="Scan interval"
                                                   Foreground="{StaticResource WhiteTextBrush}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="500ms"
                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                        <Slider Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Value="24"
                                                Margin="0,4,0,18"/>

                                        <TextBlock x:Name="OverlayOpacityLabelText"
                                                   Grid.Row="2"
                                                   Text="Overlay opacity"
                                                   Foreground="{StaticResource WhiteTextBrush}"/>
                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="1"
                                                   Text="85%"
                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                        <Slider Grid.Row="3"
                                                Grid.ColumnSpan="2"
                                                Value="85"
                                                Margin="0,4,0,18"/>

                                        <TextBlock x:Name="TextSizeLabelText"
                                                   Grid.Row="4"
                                                   Text="Text size"
                                                   Foreground="{StaticResource WhiteTextBrush}"/>
                                        <TextBlock x:Name="FontSizeScaleText"
                                                   Grid.Row="4"
                                                   Grid.Column="1"
                                                   Text="100%"
                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                        <Grid Grid.Row="5"
                                              Grid.ColumnSpan="2"
                                              Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="34"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="DecreaseFontSizeButton"
                                                    Style="{StaticResource QuietButton}"
                                                    Width="30"
                                                    Height="30"
                                                    Padding="0"
                                                    Click="DecreaseFontSizeButton_Click"
                                                    Content="-"
                                                    ToolTip="Decrease overlay font size"/>
                                            <Slider Grid.Column="1"
                                                    IsHitTestVisible="False"
                                                    Minimum="60"
                                                    Maximum="180"
                                                    Value="100"
                                                    Margin="8,3"/>
                                            <Button x:Name="IncreaseFontSizeButton"
                                                    Grid.Column="2"
                                                    Style="{StaticResource QuietButton}"
                                                    Width="30"
                                                    Height="30"
                                                    Padding="0"
                                                    Click="IncreaseFontSizeButton_Click"
                                                    Content="+"
                                                    ToolTip="Increase overlay font size"/>
                                        </Grid>
                                    </Grid>

                                    <TextBlock x:Name="BlockPaletteLabelText"
                                               Margin="0,28,0,10"
                                               Text="Block palette"
                                               Foreground="{StaticResource WhiteTextBrush}"/>
                                    <Border Background="#2A261F"
                                            BorderBrush="{StaticResource StrokeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,8">
                                        <CheckBox x:Name="BlackOverlayBlocksBox"
                                                  IsChecked="True"
                                                  Margin="0"
                                                  Content="Black / white"/>
                                    </Border>

                                    <TextBlock x:Name="MaxOcrFragmentsLabelText"
                                               Margin="0,24,0,4"
                                               Text="Max OCR fragments"
                                               Foreground="{StaticResource WhiteTextBrush}"/>
                                    <Slider Value="24"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1"
                                    Grid.Column="1"
                                    Style="{StaticResource CardBorder}"
                                    Margin="8,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="RuntimeTitleText"
                                               Style="{StaticResource SectionLabelText}"
                                               Text="RUNTIME"/>

                                    <Grid Grid.Row="1"
                                          Margin="0,22,0,18">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="26"
                                                Height="26"
                                                CornerRadius="6"
                                                Background="#1E2B1C"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="&#xE73E;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"/>
                                        </Border>
                                        <TextBlock x:Name="HotkeyRuntimeLabelText"
                                                   Grid.Column="1"
                                                   Text="Hotkey"
                                                   Foreground="{StaticResource WhiteTextBrush}"/>
                                        <TextBlock x:Name="HotkeyRuntimeText"
                                                   Grid.Column="2"
                                                   Text="Registering F6..."
                                                   Foreground="{StaticResource MutedTextBrush}"/>

                                        <Border Grid.Row="1"
                                                Width="26"
                                                Height="26"
                                                CornerRadius="6"
                                                Background="#1E2B1C"
                                                VerticalAlignment="Center"
                                                Margin="0,10,0,0">
                                            <TextBlock Text="&#xE73E;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"/>
                                        </Border>
                                        <TextBlock x:Name="PopupRuntimeLabelText"
                                                   Grid.Row="1"
                                                   Grid.Column="1"
                                                   Margin="0,14,0,0"
                                                   Text="Popup"
                                                   Foreground="{StaticResource WhiteTextBrush}"/>
                                        <TextBlock x:Name="PopupRuntimeText"
                                                   Grid.Row="1"
                                                   Grid.Column="2"
                                                   Margin="0,14,0,0"
                                                   Text="Ready"
                                                   Foreground="{StaticResource SuccessBrush}"/>

                                        <Border Grid.Row="2"
                                                Width="26"
                                                Height="26"
                                                CornerRadius="6"
                                                Background="#3A3128"
                                                VerticalAlignment="Center"
                                                Margin="0,10,0,0">
                                            <Ellipse Width="7"
                                                     Height="7"
                                                     Fill="{StaticResource MutedTextBrush}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="RealtimeRuntimeLabelText"
                                                   Grid.Row="2"
                                                   Grid.Column="1"
                                                   Margin="0,14,0,0"
                                                   Text="Realtime"
                                                   Foreground="{StaticResource WhiteTextBrush}"/>
                                        <TextBlock x:Name="RealtimeRuntimeText"
                                                   Grid.Row="2"
                                                   Grid.Column="2"
                                                   Margin="0,14,0,0"
                                                   Text="Idle"
                                                   Foreground="{StaticResource MutedTextBrush}"/>

                                        <Border Grid.Row="3"
                                                Width="26"
                                                Height="26"
                                                CornerRadius="6"
                                                Background="#342819"
                                                VerticalAlignment="Center"
                                                Margin="0,10,0,0">
                                            <TextBlock Text="&#xE946;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{StaticResource WarningBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"/>
                                        </Border>
                                        <TextBlock x:Name="RegionRuntimeLabelText"
                                                   Grid.Row="3"
                                                   Grid.Column="1"
                                                   Margin="0,14,0,0"
                                                   Text="Region"
                                                   Foreground="{StaticResource WhiteTextBrush}"/>
                                        <TextBlock x:Name="RegionRuntimeText"
                                                   Grid.Row="3"
                                                   Grid.Column="2"
                                                   Margin="0,14,0,0"
                                                   Text="Not selected"
                                                   Foreground="{StaticResource WarningBrush}"/>
                                    </Grid>

                                    <StackPanel Grid.Row="2"
                                                Margin="0,8,0,0">
                                        <TextBlock x:Name="TranslationStyleTitleText"
                                                   Style="{StaticResource SectionLabelText}"
                                                   Text="TRANSLATION STYLE"/>
                                        <TextBox x:Name="TranslationPromptBox"
                                                 Style="{StaticResource LightTextBox}"
                                                 Margin="0,12,0,0"
                                                 MinHeight="92"
                                                 MaxHeight="132"
                                                 MaxLength="1200"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top"
                                                 TextChanged="TranslationSettings_TextChanged"
                                                 Text="Translate naturally and clearly. Keep proper names, technical terms, HP/MP/EXP unchanged. Do not add explanations."/>
                                        <TextBlock x:Name="TranslationPromptRuntimeText"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,8,0,0"
                                                   Text="Custom prompt"/>
                                        <ListBox x:Name="BlocksListBox"
                                                 Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="2"
                        Background="#14110E"
                        BorderBrush="#302A24"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,16,16">
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Ellipse Width="10"
                                     Height="10"
                                     Fill="{StaticResource SuccessBrush}"
                                     Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusText"
                                       Text="Status: Ready. Highlight text and press F6, or choose Region / Full screen."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="v2.4.1"
                                   Foreground="{StaticResource DimTextBrush}"
                                   FontSize="12"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="SettingsOverlay"
              Panel.ZIndex="20"
              Visibility="Collapsed"
              Background="#AA080706"
              MouseLeftButtonDown="SettingsOverlay_MouseLeftButtonDown">
            <Border Width="520"
                    HorizontalAlignment="Right"
                    Margin="0"
                    Background="#14110E"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="24"
                    MouseLeftButtonDown="SettingsPanel_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SettingsTitleText"
                                       Text="Settings"
                                       Foreground="{StaticResource WhiteTextBrush}"
                                       FontSize="22"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="SettingsSubtitleText"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0"
                                       Text="Language and shortcuts"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource WindowChromeButton}"
                                Click="CloseSettings_Click">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,28,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="SettingsLanguageTitleText"
                                       Style="{StaticResource SectionLabelText}"
                                       Text="LANGUAGE"/>
                            <TextBlock x:Name="AppLanguageLabelText"
                                       Margin="0,14,0,8"
                                       Foreground="{StaticResource WhiteTextBrush}"
                                       Text="App language"/>
                            <ComboBox x:Name="AppLanguageBox"
                                      Style="{StaticResource LightComboBox}"
                                      SelectionChanged="AppLanguageBox_SelectionChanged">
                                <ComboBoxItem Content="English" Tag="en"/>
                                <ComboBoxItem Content="Tiếng Việt" Tag="vi"/>
                            </ComboBox>

                            <Border Height="1"
                                    Background="#302A24"
                                    Margin="0,28,0,22"/>

                            <TextBlock x:Name="SettingsShortcutsTitleText"
                                       Style="{StaticResource SectionLabelText}"
                                       Text="SHORTCUTS"/>
                            <TextBlock x:Name="ShortcutHintText"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,10,0,18"
                                       Text="Click a shortcut, then press the new key combination."/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="PopupShortcutLabelText"
                                           Text="Popup translate"
                                           Foreground="{StaticResource WhiteTextBrush}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="PopupShortcutButton"
                                        Grid.Column="1"
                                        Style="{StaticResource ShortcutButton}"
                                        Tag="PopupTranslate"
                                        Click="ShortcutButton_Click"/>

                                <TextBlock x:Name="RegionShortcutLabelText"
                                           Grid.Row="1"
                                           Margin="0,14,0,0"
                                           Text="Region translate"
                                           Foreground="{StaticResource WhiteTextBrush}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="RegionShortcutButton"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="0,10,0,0"
                                        Style="{StaticResource ShortcutButton}"
                                        Tag="RegionTranslate"
                                        Click="ShortcutButton_Click"/>

                                <TextBlock x:Name="FullScreenShortcutLabelText"
                                           Grid.Row="2"
                                           Margin="0,14,0,0"
                                           Text="Full screen realtime"
                                           Foreground="{StaticResource WhiteTextBrush}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="FullScreenShortcutButton"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="0,10,0,0"
                                        Style="{StaticResource ShortcutButton}"
                                        Tag="FullScreenRealtime"
                                        Click="ShortcutButton_Click"/>

                                <TextBlock x:Name="StopShortcutLabelText"
                                           Grid.Row="3"
                                           Margin="0,14,0,0"
                                           Text="Stop realtime"
                                           Foreground="{StaticResource WhiteTextBrush}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="StopShortcutButton"
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Margin="0,10,0,0"
                                        Style="{StaticResource ShortcutButton}"
                                        Tag="StopRealtime"
                                        Click="ShortcutButton_Click"/>

                                <TextBlock x:Name="ResetShortcutLabelText"
                                           Grid.Row="4"
                                           Margin="0,14,0,0"
                                           Text="Reset / clear overlay"
                                           Foreground="{StaticResource WhiteTextBrush}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="ResetShortcutButton"
                                        Grid.Row="4"
                                        Grid.Column="1"
                                        Margin="0,10,0,0"
                                        Style="{StaticResource ShortcutButton}"
                                        Tag="ResetOverlay"
                                        Click="ShortcutButton_Click"/>
                            </Grid>

                            <TextBlock x:Name="ShortcutErrorText"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,18,0,0"
                                       Text=""/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
