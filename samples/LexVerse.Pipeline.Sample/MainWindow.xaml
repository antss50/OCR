<Window x:Class="LexVerse.Pipeline.Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexVerse Pipeline Sample"
        Width="760"
        Height="520"
        MinWidth="640"
        MinHeight="420">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button x:Name="PickButton"
                    Width="120"
                    Margin="0,0,8,0"
                    Click="PickButton_Click"
                    Content="Pick Source"/>
            <Button x:Name="StartButton"
                    Width="90"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="StartButton_Click"
                    Content="Start"/>
            <Button x:Name="StopButton"
                    Width="90"
                    IsEnabled="False"
                    Click="StopButton_Click"
                    Content="Stop"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center" Text="Mode"/>
            <ComboBox x:Name="ModeBox" Grid.Column="1" Margin="8,0,18,0" SelectedIndex="0">
                <ComboBoxItem Content="fullscreen" Tag="fullscreen"/>
                <ComboBoxItem Content="subtitle" Tag="subtitle"/>
                <ComboBoxItem Content="game-dialogue" Tag="game-dialogue"/>
                <ComboBoxItem Content="document" Tag="document"/>
            </ComboBox>

            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="OCR"/>
            <TextBox x:Name="OcrLanguageBox" Grid.Column="3" Margin="8,0,18,0" Text="en-US"/>

            <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="Target"/>
            <TextBox x:Name="TargetLanguageBox" Grid.Column="5" Margin="8,0,0,0" Text="vi"/>
            <CheckBox x:Name="DebugOverlayBox"
                      Grid.Column="6"
                      Margin="18,0,0,0"
                      VerticalAlignment="Center"
                      Content="Debug boxes"/>
        </Grid>

        <ListBox x:Name="BlocksListBox" Grid.Row="2"/>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Margin="0,12,0,0"
                   Text="Pick a capture source to begin."/>
    </Grid>
</Window>
