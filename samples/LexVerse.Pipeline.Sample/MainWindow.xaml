<Window x:Class="LexVerse.Pipeline.Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexVerse Pipeline Sample"
        Width="820"
        Height="540"
        MinWidth="720"
        MinHeight="420">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button x:Name="PickButton"
                    Width="120"
                    Margin="0,0,8,0"
                    Click="PickButton_Click"
                    Content="Pick Source"/>
            <Button x:Name="StartButton"
                    Width="90"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="StartButton_Click"
                    Content="Start"/>
            <Button x:Name="StopButton"
                    Width="90"
                    IsEnabled="False"
                    Click="StopButton_Click"
                    Content="Stop"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center" Text="Mode"/>
            <ComboBox x:Name="ModeBox" Grid.Column="1" Margin="8,0,18,0" SelectedIndex="3">
                <ComboBoxItem Content="fullscreen" Tag="fullscreen"/>
                <ComboBoxItem Content="subtitle" Tag="subtitle"/>
                <ComboBoxItem Content="game-dialogue" Tag="game-dialogue"/>
                <ComboBoxItem Content="document" Tag="document"/>
            </ComboBox>

            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="OCR"/>
            <TextBox x:Name="OcrLanguageBox" Grid.Column="3" Margin="8,0,18,0" Text="en-US"/>

            <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="Target"/>
            <TextBox x:Name="TargetLanguageBox" Grid.Column="5" Margin="8,0,0,0" Text="vi"/>

            <StackPanel Grid.Row="1"
                        Grid.ColumnSpan="6"
                        Margin="0,10,0,0"
                        Orientation="Horizontal">
                <CheckBox x:Name="DebugOverlayBox"
                          Margin="0,0,18,0"
                          VerticalAlignment="Center"
                          Content="Debug boxes"/>
                <CheckBox x:Name="BlackOverlayBlocksBox"
                          Margin="0,0,24,0"
                          VerticalAlignment="Center"
                          IsChecked="True"
                          Content="Black blocks"/>
                <TextBlock VerticalAlignment="Center" Text="Font"/>
                <Button x:Name="DecreaseFontSizeButton"
                        Width="30"
                        Height="24"
                        Margin="8,0,0,0"
                        Click="DecreaseFontSizeButton_Click"
                        Content="-"
                        ToolTip="Decrease overlay font size"/>
                <TextBlock x:Name="FontSizeScaleText"
                           MinWidth="48"
                           Margin="8,0,8,0"
                           VerticalAlignment="Center"
                           Text="100%"
                           TextAlignment="Center"/>
                <Button x:Name="IncreaseFontSizeButton"
                        Width="30"
                        Height="24"
                        Click="IncreaseFontSizeButton_Click"
                        Content="+"
                        ToolTip="Increase overlay font size"/>
            </StackPanel>
        </Grid>

        <ListBox x:Name="BlocksListBox" Grid.Row="2"/>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Margin="0,12,0,0"
                   Text="Pick a capture source to begin."/>
    </Grid>
</Window>
