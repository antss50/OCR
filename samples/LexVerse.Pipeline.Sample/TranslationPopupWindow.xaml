<Window x:Class="LexVerse.Pipeline.Sample.TranslationPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Opacity="0"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="PopupIconButton" TargetType="Button">
            <Setter Property="Background" Value="#241F1A"/>
            <Setter Property="BorderBrush" Value="#3A3128"/>
            <Setter Property="Foreground" Value="#FFF7E9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30281F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeywordChipButton" TargetType="Button">
            <Setter Property="Background" Value="#4B3519"/>
            <Setter Property="BorderBrush" Value="#7A5625"/>
            <Setter Property="Foreground" Value="#FFD796"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5A3F1F"/>
                                <Setter Property="BorderBrush" Value="#D8A24A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="PopupShell"
            Background="#F2221F1D"
            BorderBrush="#FF3A3128"
            BorderThickness="1"
            CornerRadius="14"
            SnapsToDevicePixels="True"
            MouseLeftButtonDown="PopupShell_MouseLeftButtonDown"
            RenderTransformOrigin="0.5,0">
        <Border.RenderTransform>
            <TranslateTransform Y="10"/>
        </Border.RenderTransform>
        <StackPanel MinWidth="420"
                    MaxWidth="620">
            <Grid x:Name="HeaderBar"
                  Background="#14110E"
                  Cursor="SizeAll"
                  MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Lexverse translate"
                           Foreground="#FFFFF7E9"
                           FontWeight="Bold"
                           Margin="18,12"/>
                <Button Grid.Column="1"
                        Style="{StaticResource PopupIconButton}"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Margin="0,8,12,8"
                        Click="Close_Click">
                    <TextBlock Text="&#xE711;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="11"/>
                </Button>
            </Grid>

            <StackPanel x:Name="LoadingPanel"
                        Margin="20,18,20,20">
                <TextBlock x:Name="LoadingText"
                           Text="Translating selected text..."
                           Foreground="#FFA79A89"
                           FontSize="14"
                           TextWrapping="Wrap"/>
                <ProgressBar Height="4"
                             Margin="0,12,0,0"
                             IsIndeterminate="True"
                             Foreground="#FFD8A24A"
                             Background="#33211E17"
                             BorderThickness="0"/>
            </StackPanel>

            <StackPanel x:Name="ResultPanel"
                        Visibility="Collapsed"
                        Margin="20,16,20,20">
                <TextBlock Text="Original"
                           Foreground="#FFA79A89"
                           Margin="0,0,0,8"/>
                <Border Background="#191613"
                        CornerRadius="8"
                        Padding="12">
                    <TextBlock x:Name="SourceTextBlock"
                               Foreground="#FFFFF7E9"
                               TextWrapping="Wrap"
                               LineHeight="22"/>
                </Border>

                <TextBlock x:Name="TargetLabel"
                           Text="Vietnamese"
                           Foreground="#FFD8A24A"
                           Margin="0,16,0,8"/>
                <Border Background="#191613"
                        CornerRadius="8"
                        Padding="12">
                    <TextBlock x:Name="TranslatedTextBlock"
                               Foreground="#FFFFF7E9"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               LineHeight="24"/>
                </Border>

                <Border x:Name="KeywordPanel"
                        Background="#30281F"
                        BorderBrush="#6E5125"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Important terms"
                                   Foreground="#FFD8A24A"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <WrapPanel x:Name="KeywordItemsPanel"/>

                        <Border x:Name="KeywordDetailPanel"
                                Visibility="Collapsed"
                                Background="#211B15"
                                BorderBrush="#4B3519"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock x:Name="KeywordDetailTitle"
                                           Foreground="#FFD796"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>
                                <TextBlock x:Name="KeywordDetailText"
                                           Foreground="#FFF7E9"
                                           TextWrapping="Wrap"
                                           LineHeight="22"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
