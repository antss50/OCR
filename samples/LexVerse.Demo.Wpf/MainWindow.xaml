<Window x:Class="LexVerse.Demo.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LexVerse OCR Demo"
        Height="620"
        MinHeight="520"
        Width="920"
        MinWidth="760"
        Background="#F6F7F9">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="PickButton"
                        MinWidth="132"
                        Height="36"
                        Margin="0,0,8,0"
                        Padding="14,0"
                        Click="PickButton_Click"
                        Content="Choose source" />
                <Button x:Name="StartButton"
                        MinWidth="88"
                        Height="36"
                        Margin="0,0,8,0"
                        Padding="14,0"
                        Click="StartButton_Click"
                        IsEnabled="False"
                        Content="Start" />
                <Button x:Name="StopButton"
                        MinWidth="88"
                        Height="36"
                        Margin="0,0,8,0"
                        Padding="14,0"
                        Click="StopButton_Click"
                        IsEnabled="False"
                        Content="Stop" />
                <Button x:Name="DebugCaptureButton"
                        MinWidth="124"
                        Height="36"
                        Padding="14,0"
                        Click="DebugCaptureButton_Click"
                        IsEnabled="False"
                        Content="Debug capture" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="LexVerse OCR Demo"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#111827" />
                <TextBlock x:Name="SourceText"
                           Margin="0,4,0,0"
                           Foreground="#4B5563"
                           Text="No capture source selected." />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,14"
                Padding="12"
                Background="#E8EEF7"
                BorderBrush="#C9D7EA"
                BorderThickness="1"
                CornerRadius="6">
            <TextBlock x:Name="StatusText"
                       TextWrapping="Wrap"
                       Foreground="#1F2937"
                       Text="Choose a window or screen, then start OCR. English-only OCR is used; non-English blocks are filtered before display." />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="12,10,12,8"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               Text="Recognized text" />
                    <TextBox x:Name="ResultTextBox"
                             Grid.Row="1"
                             Padding="12"
                             AcceptsReturn="True"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="14"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold"
                               Foreground="#111827"
                               Text="Frame" />
                    <TextBlock x:Name="FrameText"
                               Grid.Row="1"
                               Margin="0,8,0,0"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               Text="Waiting for capture." />
                    <Separator Grid.Row="2"
                               Margin="0,14,0,14" />
                    <TextBlock Grid.Row="3"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               Text="OCR blocks" />
                    <ListBox x:Name="BlocksListBox"
                             Grid.Row="4"
                             Margin="0,8,0,0"
                             BorderBrush="#E5E7EB"
                             HorizontalContentAlignment="Left"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Visible" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="0,12,0,0"
                   Foreground="#6B7280"
                   Text="Demo only: capture + OCR. Translation and overlay are intentionally left for later modules." />
    </Grid>
</Window>
